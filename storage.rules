rules_version = '2';

// In der Firebase-Konsole unter Storage -> Regeln einfügen
service firebase.storage {
  match /b/{bucket}/o {

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Profilbilder: profileImages, patient_images, profile_images (alte Pfade aus iOS)
    match /{folder}/{fileName} {
      allow read: if request.auth != null
        && folder in ['profileImages', 'patient_images', 'profile_images'];
      allow write: if folder in ['profileImages', 'patient_images', 'profile_images']
        && isSelf(fileName.split('\\.')[0])
        && isImage();
    }

    // PDFs der Mitarbeiter
    match /employeeDocuments/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isSelf(uid)
        && (request.resource == null
          || (request.resource.size < 20 * 1024 * 1024
            && request.resource.contentType == 'application/pdf'));
    }
  }
}
